# JWT usado pela API. Altere o segredo fora do ambiente de desenvolvimento.
JWT_SECRET="flux-development-secret"
JWT_AUDIENCE="flux-mobile"
JWT_ISSUER="http://localhost:3333"

# API
PORT=3333

# Origens web permitidas. O aplicativo nativo não depende de CORS.
ORIGIN=http://localhost:3000,http://localhost:8081

# PostgreSQL local
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flux?schema=public"
